CREATE TABLE USERS (
    ID SERIAL NOT NULL,
    FIRST_NAME VARCHAR(255) NOT NULL,
    LAST_NAME VARCHAR(255) NOT NULL,
    EMAIL VARCHAR(255) NOT NULL UNIQUE,
    email_verified_at TIMESTAMP NULL,
	LOGIN VARCHAR(255) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    remember_token VARCHAR(100) NULL,
	AGE INT NULL,
	RATING VARCHAR(100) NULL DEFAULT "Bronze",
	role INT DEFAULT 3,
	updated_at timestamp null,

	CONSTRAINT PK_USERS PRIMARY KEY(ID)
);

CREATE TABLE CARDS (
    CARD_ID SERIAL NOT NULL,
    CARD_NAME VARCHAR(255) NOT NULL UNIQUE,
    PRICE FLOAT NULL,
	TEXT_RULES TEXT NULL,
	ILLUSTRATION_AUTHOR VARCHAR(255) NOT NULL,
	FLAVOR_TEXT TEXT NULL,
	IMAGE_HREF TEXT NULL,
	POWER INT NULL,
	THOUGHTNESS INT NULL,
	updated_at timestamp null,
    
	CONSTRAINT PK_CARDS PRIMARY KEY(CARD_ID)
);

CREATE TABLE TYPES (
    TYPE_ID SERIAL NOT NULL,
    TYPE_NAME VARCHAR(255) NOT NULL UNIQUE,
    
	CONSTRAINT PK_TYPES PRIMARY KEY(TYPE_ID)
);

CREATE TABLE CARDS_TYPES (
    CARD_ID INT NOT NULL,
    TYPE_ID INT NOT NULL,
    
	CONSTRAINT PK_CARDS_TYPES PRIMARY KEY(CARD_ID, TYPE_ID),
	CONSTRAINT FK_CARDS_TO_TYPES FOREIGN KEY(TYPE_ID)
		REFERENCES TYPES(TYPE_ID) ON UPDATE CASCADE ON DELETE CASCADE,
	CONSTRAINT FK_TYPES_TO_CARDS FOREIGN KEY(CARD_ID)
		REFERENCES CARDS(CARD_ID) ON UPDATE CASCADE ON DELETE CASCADE
);

CREATE TABLE SUBTYPES (
    SUBTYPE_ID SERIAL NOT NULL,
    SUBTYPE_NAME VARCHAR(255) NOT NULL UNIQUE,
    
	CONSTRAINT PK_SUBTYPES PRIMARY KEY(SUBTYPE_ID)
);

CREATE TABLE CARDS_SUBTYPES (
    CARD_ID INT NOT NULL,
    SUBTYPE_ID INT NOT NULL,
    
	CONSTRAINT PK_CARDS_SUBTYPES PRIMARY KEY(CARD_ID, SUBTYPE_ID),
	CONSTRAINT FK_CARDS_TO_SUBTYPES FOREIGN KEY(SUBTYPE_ID)
		REFERENCES SUBTYPES(SUBTYPE_ID) ON UPDATE CASCADE ON DELETE CASCADE,
	CONSTRAINT FK_SUBTYPES_TO_CARDS FOREIGN KEY(CARD_ID)
		REFERENCES CARDS(CARD_ID) ON UPDATE CASCADE ON DELETE CASCADE
);

CREATE TABLE SUPERTYPES (
    SUPERTYPE_ID SERIAL NOT NULL,
    SUPERTYPE_NAME VARCHAR(255) NOT NULL UNIQUE,
    
	CONSTRAINT PK_SUPERTYPES PRIMARY KEY(SUPERTYPE_ID)
);

CREATE TABLE CARDS_SUPERTYPES (
    CARD_ID INT NOT NULL,
    SUPERTYPE_ID INT NOT NULL,
    
	CONSTRAINT PK_CARDS_SUPERTYPES PRIMARY KEY(CARD_ID, SUPERTYPE_ID),
	CONSTRAINT FK_CARDS_TO_SUPERTYPES FOREIGN KEY(SUPERTYPE_ID)
		REFERENCES SUPERTYPES(SUPERTYPE_ID) ON UPDATE CASCADE ON DELETE CASCADE,
	CONSTRAINT FK_SUPERTYPES_TO_CARDS FOREIGN KEY(CARD_ID)
		REFERENCES CARDS(CARD_ID) ON UPDATE CASCADE ON DELETE CASCADE
);

CREATE TABLE USERS_CARDS (
	USER_ID INT NOT NULL,
    CARD_ID INT NOT NULL,
    DATE_OF_RECEIPT TIMESTAMP DEFAULT NOW(),
    
	CONSTRAINT PK_USERS_CARDS PRIMARY KEY(USER_ID, CARD_ID),
	CONSTRAINT FK_CARDS_TO_USERS FOREIGN KEY(CARD_ID)
		REFERENCES CARDS(CARD_ID) ON UPDATE CASCADE ON DELETE CASCADE,
	CONSTRAINT FK_USERS_TO_CARDS FOREIGN KEY(USER_ID)
		REFERENCES USERS(ID) ON UPDATE CASCADE ON DELETE CASCADE
);

CREATE TABLE FORMATS (
	FORMAT_NAME VARCHAR(255) NOT NULL,
	MIN_CARDS_IN_DECK INT NOT NULL,
	MAX_CARDS_IN_DECK INT NULL,
	FORMAT_DESCRIPTION TEXT NOT NULL,
    
	CONSTRAINT PK_FORMATS PRIMARY KEY(FORMAT_NAME)
);

CREATE TABLE TOURNAMENTS (
	TOURNAMENT_ID SERIAL NOT NULL,
	TOURNAMENT_NAME VARCHAR(255) NULL,
	TOURNAMENT_DESCRIPTION TEXT NULL,
	FORMAT_NAME VARCHAR(255) DEFAULT 'Standard',
	TOURNAMENT_DATE TIMESTAMP NOT NULL,
	STATUS VARCHAR(255),
    
	CONSTRAINT PK_TOURNAMENT PRIMARY KEY(TOURNAMENT_ID),
	CONSTRAINT FK_TOURNAMENTS_FORMATS FOREIGN KEY(FORMAT_NAME)
		REFERENCES FORMATS(FORMAT_NAME) ON UPDATE CASCADE ON DELETE SET DEFAULT
);

CREATE TABLE TRADING_LOTS (
	LOT_ID SERIAL NOT NULL,
	USER_ID INT NOT NULL,
	LOT_NAME VARCHAR(255) NOT NULL,
	LOT_DESCRIPTION TEXT NULL,
	PRICE FLOAT NULL,
	
	CONSTRAINT PK_TRADING_LOTS PRIMARY KEY(LOT_ID),
	CONSTRAINT FK_USERS_LOTS FOREIGN KEY(USER_ID)
		REFERENCES USERS(ID) ON UPDATE CASCADE ON DELETE CASCADE
);

CREATE TABLE USERS_TOURNAMENTS (
	USER_ID INT NOT NULL,
    TOURNAMENT_ID INT NOT NULL,
    DATE_OF_REGISTRATION TIMESTAMP DEFAULT NOW(),
    
	CONSTRAINT PK_USERS_TOURNAMENTS PRIMARY KEY(USER_ID, TOURNAMENT_ID),
	CONSTRAINT FK_TOURNAMENTS_TO_USERS FOREIGN KEY(TOURNAMENT_ID)
		REFERENCES TOURNAMENTS(TOURNAMENT_ID) ON UPDATE CASCADE ON DELETE CASCADE,
	CONSTRAINT FK_USERS_TO_TOURNAMENTS FOREIGN KEY(USER_ID)
		REFERENCES USERS(ID) ON UPDATE CASCADE ON DELETE CASCADE
);

CREATE TABLE RESTRICTED_CARDS (
	CARD_ID INT NOT NULL,
    FORMAT_NAME VARCHAR(255) NOT NULL,
	RESTRICTION_TYPE VARCHAR(255) NOT NULL,
	RESCTRICTION_DESCRIPTION TEXT NULL,
    DATE_OF_RESTRICTION DATE DEFAULT NOW(),
    
	CONSTRAINT PK_RESCTRICTED_CARDS PRIMARY KEY(CARD_ID, FORMAT_NAME),
	CONSTRAINT FK_CARDS_TO_RESTRICTED_CARDS FOREIGN KEY(CARD_ID)
		REFERENCES CARDS(CARD_ID) ON UPDATE CASCADE ON DELETE CASCADE,
	CONSTRAINT FK_RESTRICTED_CARDS_TO_CARDS FOREIGN KEY(FORMAT_NAME)
		REFERENCES FORMATS(FORMAT_NAME) ON UPDATE CASCADE ON DELETE CASCADE
);

CREATE TABLE SETS (
	SET_ID SERIAL NOT NULL,
    SET_NAME VARCHAR(255) NOT NULL UNIQUE,
	NUMBER_OF_CARDS INT NOT NULL,
    DATE_OF_RELEASE DATE NOT NULL,
    
	CONSTRAINT PK_SET PRIMARY KEY(SET_ID)
);

CREATE TABLE CARDS_SETS (
    CARD_ID INT NOT NULL,
	SET_ID INT NOT NULL,
	
	CONSTRAINT PK_CARDS_SETS PRIMARY KEY(CARD_ID, SET_ID),
	CONSTRAINT FK_CARDS_TO_SETS FOREIGN KEY(CARD_ID)
		REFERENCES CARDS(CARD_ID) ON UPDATE CASCADE ON DELETE CASCADE,
	CONSTRAINT FK_SETS_TO_CARDS FOREIGN KEY(SET_ID)
		REFERENCES SETS(SET_ID) ON UPDATE CASCADE ON DELETE CASCADE
);

CREATE TABLE KEYWORDS (
    KEYWORD_ID SERIAL NOT NULL,
	KEYWORD_NAME VARCHAR(255) NOT NULL,
	KEYWORD_DESCRIPTION TEXT NULL,
	
	CONSTRAINT PK_KEYWORDS PRIMARY KEY(KEYWORD_ID)
);

CREATE TABLE CARDS_KEYWORDS (
    CARD_ID INT NOT NULL,
	KEYWORD_ID INT NOT NULL,
	
	CONSTRAINT PK_CARDS_KEYWORDS PRIMARY KEY(CARD_ID, KEYWORD_ID),
	CONSTRAINT FK_CARDS_TO_KEYWORDS FOREIGN KEY(CARD_ID)
		REFERENCES CARDS(CARD_ID) ON UPDATE CASCADE ON DELETE CASCADE,
	CONSTRAINT FK_KEYWORDS_TO_CARDS FOREIGN KEY(KEYWORD_ID)
		REFERENCES KEYWORDS(KEYWORD_ID) ON UPDATE CASCADE ON DELETE CASCADE
);

CREATE TABLE MANA_VALUE (
    CARD_ID INT NOT NULL,
	WHITE_MANA INT NULL,
	BLUE_MANA INT NULL,
	BLACK_MANA INT NULL,
	RED_MANA INT NULL,
	GREEN_MANA INT NULL,
	COLORLESS_MANA INT NULL,
	updated_at timestamp null,


	CONSTRAINT PK_MANA_VALUE PRIMARY KEY(CARD_ID),
	CONSTRAINT FK_CARDS_TO_MANA_VALUE FOREIGN KEY(CARD_ID)
		REFERENCES CARDS(CARD_ID) ON UPDATE CASCADE ON DELETE CASCADE
);

CREATE TABLE DECKS (
    DECK_ID SERIAL NOT NULL,
	DECK_NAME VARCHAR(255) NOT NULL UNIQUE,
	FORMAT_NAME VARCHAR(255) DEFAULT 'Standard',
	POWER_LEVEL INT NULL,
	USER_ID INT NULL,
	updated_at timestamp null,

	CONSTRAINT PK_DECK PRIMARY KEY(DECK_ID),
	CONSTRAINT FK_DECKS_TO_USERS FOREIGN KEY(USER_ID)
		REFERENCES USERS(ID) ON UPDATE CASCADE ON DELETE SET NULL
	CONSTRAINT FK_DECKS_TO_FORMATS FOREIGN KEY(FORMAT_NAME)
		REFERENCES FORMATS(FORMAT_NAME) ON UPDATE CASCADE ON DELETE SET DEFAULT
);

CREATE TABLE DECKS_CARDS (
	DECK_ID INT NOT NULL,
    CARD_ID INT NOT NULL,
	DATE_OF_ADDED TIMESTAMP DEFAULT NOW(),

	CONSTRAINT FK_DECKS_TO_CARDS FOREIGN KEY(CARD_ID)
		REFERENCES CARDS(CARD_ID) ON UPDATE CASCADE ON DELETE CASCADE,
	CONSTRAINT FK_CARDS_TO_DECKS FOREIGN KEY(DECK_ID)
		REFERENCES DECKS(DECK_ID) ON UPDATE CASCADE ON DELETE CASCADE
);





