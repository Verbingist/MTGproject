AFTER INSERT ON CARDS
FOR EACH ROW 
EXECUTE FUNCTION INITIALIZE_MANA_VALUE()



CREATE FUNCTION INR_SET_COUNT()
RETURNS TRIGGER 
LANGUAGE plpgsql
AS $$
BEGIN
  UPDATE SETS SET NUMBER_OF_CARDS = NUMBER_OF_CARDS + 1 WHERE SET_ID = NEW.SET_ID;
  RETURN NEW;
END;
$$

CREATE TRIGGER TG_INR_SET_COUNT 
AFTER INSERT ON CARDS_SETS 
FOR EACH ROW 
EXECUTE FUNCTION INR_SET_COUNT();



CREATE FUNCTION DCR_SET_COUNT()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
DECLARE
  NEW_COUNT INT;
BEGIN
  SELECT NUMBER_OF_CARDS INTO NEW_COUNT FROM SETS WHERE SET_ID = OLD.SET_ID;
  IF NEW_COUNT IS NULL THEN
      NEW_COUNT := 0;
  ELSE
      NEW_COUNT := NEW_COUNT - 1;
  END IF;

  UPDATE SETS SET NUMBER_OF_CARDS = NEW_COUNT
  WHERE SET_ID = OLD.SET_ID;
  RETURN OLD;
END;
$$;

CREATE TRIGGER TG_DCR_SET_COUNT 
AFTER DELETE ON CARDS_SETS 
FOR EACH ROW 
EXECUTE FUNCTION DCR_SET_COUNT();



CREATE FUNCTION SET_TOURNAMENT_STATUS()
RETURNS TRIGGER 
LANGUAGE plpgsql
AS $$
BEGIN
  IF DATE(NEW.TOURNAMENT_DATE) < CURRENT_DATE THEN
    NEW.STATUS := 'Completed';
  ELSEIF NEW.STATUS IS NULL THEN
    NEW.STATUS := 'Scheduled';
  END IF;
  RETURN NEW;
END;
$$;

CREATE TRIGGER TG_SET_TOURNAMENT_STATUS
BEFORE INSERT OR UPDATE ON TOURNAMENTS
FOR EACH ROW 
EXECUTE FUNCTION SET_TOURNAMENT_STATUS();



CREATE FUNCTION UPDATE_USER_RATING()
RETURNS TRIGGER 
LANGUAGE plpgsql
AS $$
DECLARE
    TOURNAMENT_COUNT INT;
    NEW_RATING VARCHAR(100);
BEGIN
    SELECT COUNT(*) INTO TOURNAMENT_COUNT
    FROM USERS_TOURNAMENTS
    WHERE USER_ID = NEW.USER_ID;

    IF TOURNAMENT_COUNT >= 15 THEN
        NEW_RATING := 'Mythic';
    ELSIF TOURNAMENT_COUNT >= 10 THEN
        NEW_RATING := 'Gold';
    ELSIF TOURNAMENT_COUNT >= 5 THEN
        NEW_RATING := 'Silver';
    ELSE
        NEW_RATING := 'Bronze';
    END IF;

    UPDATE USERS
    SET RATING = NEW_RATING
    WHERE ID = NEW.USER_ID;

    RETURN NULL;
END;
$$;

CREATE TRIGGER TG_UPDATE_USER_RATING
AFTER INSERT ON USERS_TOURNAMENTS
FOR EACH ROW
EXECUTE FUNCTION UPDATE_USER_RATING();




